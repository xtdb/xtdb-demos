# Copy to .env to override. Every value here is the compose default.

# Node image. Pinned published release candidate, matching docker-compose.yml.
XTDB_IMAGE=ghcr.io/xtdb/xtdb:2.2.0-rc0

# Host ports. Change these to run alongside another XTDB node.
XTDB_PGWIRE_PORT=5444
XTDB_FLIGHT_PORT=9834
XTDB_HEALTHZ_PORT=8084
PLAYGROUND_PORT=5445
API_PORT=8000
UI_PORT=5173

# The 300k-row dataset wants more than the defaults; 8g/8g is comfortable.
XTDB_HEAP=4g
XTDB_DIRECT_MEM=4g
